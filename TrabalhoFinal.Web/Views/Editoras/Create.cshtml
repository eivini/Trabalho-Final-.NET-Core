@model TrabalhoFinal.Application.ViewModels.EditoraViewModel

@{
    ViewData["Title"] = "Nova Editora";
}

<h1>Nova Editora</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Shueisha" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Pais" class="form-label"></label>
                <input asp-for="Pais" class="form-control" placeholder="Ex: Japão" />
                <span asp-validation-for="Pais" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="AnoFundacao" class="form-label"></label>
                <input asp-for="AnoFundacao" class="form-control" type="number" placeholder="Ex: 1925" />
                <span asp-validation-for="AnoFundacao" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Site" class="form-label"></label>
                <input asp-for="Site" class="form-control" placeholder="Ex: https://www.shueisha.co.jp" />
                <span asp-validation-for="Site" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
