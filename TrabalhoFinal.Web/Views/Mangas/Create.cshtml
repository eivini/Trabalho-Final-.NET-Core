@model TrabalhoFinal.Application.ViewModels.MangaViewModel

@{
    ViewData["Title"] = "Novo Mangá";
}

<h1>Novo Mangá</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ex: One Piece" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Autor" class="form-label"></label>
                <input asp-for="Autor" class="form-control" placeholder="Ex: Eiichiro Oda" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Genero" class="form-label"></label>
                    <input asp-for="Genero" class="form-control" placeholder="Ex: Aventura, Ação" />
                    <span asp-validation-for="Genero" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Volumes" class="form-label"></label>
                    <input asp-for="Volumes" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Volumes" class="text-danger"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AnoPublicacao" class="form-label"></label>
                    <input asp-for="AnoPublicacao" class="form-control" type="number" min="1950" />
                    <span asp-validation-for="AnoPublicacao" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Preco" class="form-label"></label>
                    <input asp-for="Preco" class="form-control" type="number" step="0.01" min="5" />
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="EditoraId" class="form-label"></label>
                <select asp-for="EditoraId" class="form-select" asp-items="ViewBag.Editoras">
                    <option value="">-- Selecione uma Editora --</option>
                </select>
                <span asp-validation-for="EditoraId" class="text-danger"></span>
            </div>
            
            <div class="mb-3 form-check">
                <input asp-for="EmAndamento" class="form-check-input" type="checkbox" />
                <label asp-for="EmAndamento" class="form-check-label"></label>
            </div>
            
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
