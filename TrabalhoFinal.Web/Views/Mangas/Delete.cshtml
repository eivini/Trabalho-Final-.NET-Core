@model TrabalhoFinal.Application.ViewModels.MangaViewModel

@{
    ViewData["Title"] = "Excluir Mangá";
}

<h1 class="text-danger">Excluir Mangá</h1>
<hr />

<div class="alert alert-warning">
    <h4>⚠️ Atenção!</h4>
    <p>Você tem certeza que deseja excluir este mangá?</p>
</div>

<div class="row">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Título</dt>
            <dd class="col-sm-9"><strong>@Model.Titulo</strong></dd>
            
            <dt class="col-sm-3">Autor</dt>
            <dd class="col-sm-9">@Model.Autor</dd>
            
            <dt class="col-sm-3">Gênero</dt>
            <dd class="col-sm-9">@Model.Genero</dd>
            
            <dt class="col-sm-3">Volumes</dt>
            <dd class="col-sm-9">@Model.Volumes</dd>
            
            <dt class="col-sm-3">Editora</dt>
            <dd class="col-sm-9">@Model.EditoraNome</dd>
            
            <dt class="col-sm-3">Preço</dt>
            <dd class="col-sm-9">R$ @Model.Preco.ToString("N2")</dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
